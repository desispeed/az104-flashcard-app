# Copy to .env and fill in. NEVER commit the real .env — this is your account token.
#
# Get the token on a DESKTOP machine (has browser + keychain):
#   1. Download dd-cli for your desktop OS from the releases page.
#   2. dd-cli login          # opens browser, signs in to your DoorDash account
#   3. dd-cli export-token    # prints an access token
# Paste that value here:
DD_CLI_ACCESS_TOKEN=paste-your-access-token-here

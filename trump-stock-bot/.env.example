# ─── Telegram (required) ───────────────────────────────────────────────
# 1. Open Telegram, talk to @BotFather, send /newbot, copy the token here.
# 2. Send any message to your new bot, then get your chat id from
#    https://api.telegram.org/bot<TOKEN>/getUpdates  (look for "chat":{"id":...})
#    or message @userinfobot which replies with your id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Truth Social (optional) ───────────────────────────────────────────
# Credentials for a Truth Social account used to read public posts.
# Leave blank to disable the Truth Social source.
TRUTHSOCIAL_USERNAME=
TRUTHSOCIAL_PASSWORD=
# Whose posts to track (no leading @).
TRUTHSOCIAL_HANDLE=realDonaldTrump

# ─── Behaviour (optional, sensible defaults) ───────────────────────────
# How far back each scan looks, in hours.
LOOKBACK_HOURS=1
# Interval between scans when running in --loop mode, in seconds (3600 = 1h).
SCAN_INTERVAL_SECONDS=3600
# Comma-separated source toggles. Remove any you don't want.
ENABLED_SOURCES=google_news,gdelt,truth_social
# Only send a Telegram alert when a directional lean is found (UP/DOWN).
# Set to false to also get UNCERTAIN matches.
NOTIFY_ONLY_DIRECTIONAL=true

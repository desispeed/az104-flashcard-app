# ElevenLabs API key - get yours at https://elevenlabs.io
ELEVEN_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs voice ID - find voices at https://elevenlabs.io/voice-library
# Default: "JBFqnCBsd6RMkjVDRZzb" (George)
ELEVEN_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs model - options: eleven_v3, eleven_multilingual_v2, eleven_flash_v2_5
ELEVEN_MODEL_ID=eleven_multilingual_v2

# News API key - get yours at https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# News preferences
NEWS_COUNTRY=us
NEWS_CATEGORY=general
NEWS_MAX_ARTICLES=5

# Sonos speaker name (as shown in your Sonos app) - leave empty to auto-discover
SONOS_SPEAKER_NAME=

# Schedule time (24h format, HH:MM)
SUMMARY_TIME=07:30

# Local server port for serving audio to Sonos
LOCAL_SERVER_PORT=8765

# ElevenLabs API key - get yours at https://elevenlabs.io
ELEVEN_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs voice ID - find voices at https://elevenlabs.io/voice-library
# Default: "JBFqnCBsd6RMkjVDRZzb" (George)
ELEVEN_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs model - options: eleven_v3, eleven_multilingual_v2, eleven_flash_v2_5
ELEVEN_MODEL_ID=eleven_multilingual_v2

# Brave Search API key - get yours at https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# News search query (customise to your interests)
NEWS_QUERY=top news today
NEWS_MAX_ARTICLES=5

# --- Playback: choose Home Assistant OR direct Sonos ---

# Option A: Home Assistant (recommended for remote/GCP deployment)
# Set all three to enable HA mode. Run `python bot.py --list` to find your entity_id.
HA_URL=https://your-instance.ui.nabu.casa
HA_TOKEN=your_long_lived_access_token
HA_MEDIA_PLAYER=media_player.your_sonos_speaker

# Option B: Direct Sonos (requires same LAN as Sonos speakers)
# Only used if HA_URL is not set. Leave empty to auto-discover.
SONOS_SPEAKER_NAME=

# Schedule time (24h format, HH:MM)
SUMMARY_TIME=07:30

# Port for serving audio (must be open in GCP firewall for HA mode)
LOCAL_SERVER_PORT=8765

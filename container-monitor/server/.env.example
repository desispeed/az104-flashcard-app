# Copy to .env and fill in. NEVER commit the real .env.

# Long random shared secret the iOS app must send as "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 32
API_TOKEN=change-me-openssl-rand-hex-32

# Port the agent listens on.
PORT=8080

# Hosts to monitor. Empty dockerHost = the local Docker daemon (the machine
# running this agent). Use ssh://user@host for remote hosts reached over SSH.
#
# Recommended layout: run this agent ON your MacBook so the Mac is local and
# the VM (public IP) is reached over SSH.
HOSTS_JSON=[{"name":"MacBook","dockerHost":""},{"name":"GCP VM","dockerHost":"ssh://you@VM_EXTERNAL_IP"}]

# Optional: per-host docker timeout in milliseconds (default 15000).
# DOCKER_TIMEOUT_MS=15000

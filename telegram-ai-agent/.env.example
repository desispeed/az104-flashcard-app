# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ── AI Provider ──
# Choose: "anthropic" (Claude API) or "openai" (any OpenAI-compatible endpoint)
AI_PROVIDER=anthropic

# ── Anthropic (Claude) ──
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── OpenAI-compatible (Ollama, LM Studio, vLLM, local models, zero API cost) ──
# Set AI_PROVIDER=openai to use these instead of Anthropic
OPENAI_API_KEY=not-needed
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3

# ── Agent settings ──
MAX_TOKENS=4096
# Max tool-use rounds per message (agentic loop depth)
MAX_TOOL_ROUNDS=10

# Allowed Telegram user IDs (comma-separated, leave empty to allow all)
ALLOWED_USERS=

# Enable task execution (shell commands, file ops)
ENABLE_TASK_EXECUTION=true

# Sandbox shell commands (restrict to safe commands)
SANDBOX_MODE=true

# Heartbeat interval in minutes (0 to disable)
HEARTBEAT_INTERVAL=30

# Memory directory
MEMORY_DIR=./memory

# Skills directory
SKILLS_DIR=./skills
